# Replace named placeholders explicitly. This is a standalone optional proxy.
worker_processes 1;
pid @PREFIX@/nginx.pid;
error_log /dev/null crit;
worker_shutdown_timeout 5s;
events { worker_connections 128; }
http {
    server_tokens off;
    log_format kiarni_safe escape=json '{"status":$status,"request_id":"$upstream_http_x_request_id","duration":"$request_time"}';
    access_log @PREFIX@/access.log kiarni_safe;
    client_body_temp_path @PREFIX@/body;
    proxy_temp_path @PREFIX@/proxy;
    # Keep default temp paths of distro-built optional modules in this prefix.
    fastcgi_temp_path @PREFIX@/fastcgi;
    uwsgi_temp_path @PREFIX@/uwsgi;
    scgi_temp_path @PREFIX@/scgi;
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 8k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;
    keepalive_timeout 10s;
    keepalive_requests 100;
    reset_timedout_connection on;
    gzip off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:kiarni_tls:1m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    ssl_early_data off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    limit_conn_zone $binary_remote_addr zone=kiarni_client:1m;
    limit_conn_zone $server_name zone=kiarni_total:1m;
    limit_req_zone $binary_remote_addr zone=kiarni_rate:1m rate=20r/s;
    limit_conn_status 429;
    limit_req_status 429;
    server {
        listen @LISTEN@ ssl default_server;
        ssl_reject_handshake on;
        return 421;
    }
    server {
        listen @LISTEN@ ssl;
        server_name @SERVER_NAME@;
        ssl_certificate @CERT@;
        ssl_certificate_key @KEY@;
        if ($http_host != "@AUTHORITY@") { return 421; }
        add_header Strict-Transport-Security "max-age=31536000" always;
        location / {
            limit_conn kiarni_client 16;
            limit_conn kiarni_total 32;
            limit_req zone=kiarni_rate burst=40 nodelay;
            proxy_pass http://@UPSTREAM@;
            proxy_http_version 1.1;
            proxy_set_header Host "@AUTHORITY@";
            proxy_set_header Connection "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Real-IP "";
            proxy_pass_request_headers on;
            proxy_request_buffering on;
            proxy_buffering off;
            proxy_buffer_size 8k;
            proxy_max_temp_file_size 0;
            proxy_cache off;
            proxy_next_upstream off;
            proxy_connect_timeout 2s;
            proxy_send_timeout 10s;
            proxy_read_timeout 75s;
            proxy_ignore_client_abort off;
            proxy_intercept_errors off;
            proxy_redirect off;
        }
    }
}
